            function parseCsvData(csvText) {
                if (!csvText) return {};
                const data = {};
                const lines = csvText.trim().split(/\r?\n/);
                if (lines.length <= 1) return {};
                const chineseNumMap = { '一': 1, '二': 2, '三': 3, '四': 4, '五': 5, '六': 6, '七': 7, '八': 8, '九': 9, '十': 10, '十一': 11, '十二': 12, '十三': 13, '十四': 14, '首': 1 };
                for (let i = 1; i < lines.length; i++) {
                    const columns = lines[i].split('\t');
                    if (columns.length < 4) continue;
                    const gradeNumber = columns[0];
                    let semester = columns[1];
                    if (semester === '1') semester = '上';
                    if (semester === '2') semester = '下';
                    const lessonRaw = columns[2];
                    const lesson = chineseNumMap[lessonRaw] || parseInt(lessonRaw) || 0;
                    const chars = columns[3];
                    if (!gradeNumber || !semester || !lesson || !chars) continue;
                    if (!data[gradeNumber]) data[gradeNumber] = {};
                    if (!data[gradeNumber][semester]) data[gradeNumber][semester] = {};
                    if (!data[gradeNumber][semester][lesson]) data[gradeNumber][semester][lesson] = [];
                    const currentChars = new Set(data[gradeNumber][semester][lesson]);
                    chars.split('').forEach(char => currentChars.add(char));
                    data[gradeNumber][semester][lesson] = [...currentChars];
                }
                return data;
            }

