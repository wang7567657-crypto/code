            // 新增：背景生圖佇列控制函式
            function startBackgroundImageGeneration(indices, concurrency) {
                const queue = [...indices];
                
                // 定義 Worker：只要佇列還有東西，就持續處理
                const worker = async () => {
                    while (queue.length > 0) {
                        const index = queue.shift();
                        if (index === undefined) break; // 雙重檢查
                        
                        try {
                            // 等待目前的生圖任務完成（包含重試邏輯）
                            // 這樣可以確保 worker 佔用時間直到完成，維持固定併發數
                            await triggerExtraPhrasesGeneration(index);
                        } catch (e) {
                            console.error(`Background generation error at index ${index}:`, e);
                        }
                    }
                };

                // 啟動指定數量的 Worker (若總數少於併發數，則只啟動需要的數量)
                const numWorkers = Math.min(concurrency, indices.length);
                console.log(`啟動 ${numWorkers} 個生圖執行緒...`);
                for (let i = 0; i < numWorkers; i++) {
                    worker();
                }
            }

