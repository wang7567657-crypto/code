                    const finalFolderName = saveFolderInput.value.trim() || '未分類';
                    
                    const recordData = [];
                    const primaryText = document.getElementById('primary-tsv-input').value.trim();
                    if (!primaryText) { showToast("無教材資料可儲存。"); return; }
                    
                    const primaryLines = primaryText.split(/\r?\n/).filter(line => line.trim() !== '');
                    let pStart = (primaryLines[0].includes("生字")) ? 1 : 0;
                    
                    for (let i = pStart; i < primaryLines.length; i++) {
                        let row = primaryLines[i].includes('\t') ? primaryLines[i].split('\t') : primaryLines[i].split(',');
                        if (row.length >= 6) {
                            recordData.push({ 
                                char: row[0].replace(/^"|"$/g, '').replace(/""/g, '"').trim(), 
                                bopomofo: row[1].replace(/^"|"$/g, '').replace(/""/g, '"').trim(), 
                                phrase: row[2].replace(/^"|"$/g, '').replace(/""/g, '"').trim(), 
                                phraseBopomofo: row[3].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                meaning: row[4].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                sentence: row[5].replace(/^"|"$/g, '').replace(/""/g, '"').trim()
                            });
                        }
                    }

                    if (recordData.length === 0) { showToast("無法收集資料，請確認格式正確。"); return; }
                    if (!db || !userId) { showToast("無法連接資料庫，儲存失敗。"); return; }

                    // 解析擴充語詞 (為了儲存到 extraPhrases)
                    const extraText = document.getElementById('extra-tsv-input').value.trim();
                    let extraPhrasesToSave = {};
                    if (extraText) {
                        const extraLines = extraText.split(/\r?\n/).filter(line => line.trim() !== '');
                        let eStart = (extraLines[0].includes("生字") || extraLines[0].includes("語詞")) ? 1 : 0;
                        for (let i = eStart; i < extraLines.length; i++) {
                            let row = extraLines[i].includes('\t') ? extraLines[i].split('\t') : extraLines[i].split(',');
                            if (row.length >= 5) {
                                const char = row[0].replace(/^"|"$/g, '').replace(/""/g, '"').trim();
                                if (!extraPhrasesToSave[char]) extraPhrasesToSave[char] = [];
                                extraPhrasesToSave[char].push({
                                    phrase: row[1].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                    bopomofo: row[2].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                    meaning: row[3].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                    sentence: row[4].replace(/^"|"$/g, '').replace(/""/g, '"').trim()
                                });
                            }
                        }
                    }

                    saveModalConfirmBtn.disabled = true;
                    saveModalConfirmBtn.textContent = '儲存中...';

                    try {
                        const historyCollection = collection(db, 'artifacts', appId, 'users', userId, 'history');
                        await addDoc(historyCollection, { 
                            type: 'record', 
                            name: finalRecordName, 
                            folder: finalFolderName, 
                            content: recordData, 
                            extraPhrases: extraPhrasesToSave, 
                            timestamp: serverTimestamp() 
                        });
                        showToast(`記錄「${finalRecordName}」已儲存！`);
                        saveRecordModal.classList.add('hidden');
