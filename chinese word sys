// 筆畫配對啟動邏輯 (結合你原有的 Drag & Drop 程式碼)
function startWriterPuzzle() {
    if (!currentHanziWriter) return;
    currentStrokeStep = 0;
    const hiddenIndices = currentHanziWriter.startPuzzle(puzzleHideCount);
    
    if (!hiddenIndices || hiddenIndices.length === 0) {
        showToast("此字筆畫太少，無法配對。");
        return;
    }

    puzzleContainer.classList.remove('hidden');
    puzzleContainer.innerHTML = '';
    
    const shuffledIndices = [...hiddenIndices].sort(() => Math.random() - 0.5);

    shuffledIndices.forEach(idx => {
        const pieceDiv = document.createElement('div');
        pieceDiv.className = 'puzzle-piece w-14 h-14 border-2 border-slate-300 rounded-xl bg-white shadow-sm flex items-center justify-center p-1 cursor-grab active:cursor-grabbing hover:bg-slate-50 relative touch-none';
        pieceDiv.dataset.strokeIndex = idx;
        
        const pathData = currentHanziWriter.strokesData[idx].pathString;
        pieceDiv.innerHTML = `<svg viewBox="0 0 2048 2048" class="w-full h-full pointer-events-none"><path d="${pathData}" fill="#111827" /></svg>`;

        let isDragging = false;
        let clone = null;

        const startDrag = (e) => {
            const nextExpected = currentHanziWriter.hiddenStrokes.find(i => !currentHanziWriter.placedStrokes.includes(i));
            if (idx !== nextExpected) {
                pieceDiv.classList.add('bg-red-100', 'border-red-400');
                setTimeout(() => pieceDiv.classList.remove('bg-red-100', 'border-red-400'), 300);
                currentHanziWriter.triggerError();
                return;
            }

            e.preventDefault();
            isDragging = true;
            pieceDiv.classList.add('opacity-40');
            
            // 👉 改用 280x280 的完美對齊殘影
            clone = document.createElement('div');
            clone.className = 'fixed pointer-events-none z-[200] w-[280px] h-[280px] drop-shadow-2xl opacity-80';
            clone.innerHTML = `<svg viewBox="0 0 2048 2048" class="w-full h-full"><path d="${pathData}" fill="#ef4444" /></svg>`;
            document.body.appendChild(clone);
            
            moveClone(e);
        };

        const moveClone = (e) => {
            if (!isDragging || !clone) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            
            const median = currentHanziWriter.strokesData[idx].median;
            let strokeCx = currentHanziWriter.width / 2, strokeCy = currentHanziWriter.height / 2;
            if (median && median.length > 0) {
                strokeCx = median.reduce((sum, p) => sum + p.x, 0) / median.length;
                strokeCy = median.reduce((sum, p) => sum + p.y, 0) / median.length;
            }
            
            // 👉 使用跟 React 一樣的 translate 動態位移，確保指尖在筆畫中心！
            clone.style.left = `${clientX}px`;
            clone.style.top = `${clientY}px`;
            clone.style.transform = `translate(-${strokeCx}px, -${strokeCy}px)`;
        };

        const endDrag = (e) => {
            if (!isDragging) return;
            isDragging = false;
            pieceDiv.classList.remove('opacity-40');
            if (clone) {
                clone.remove();
                clone = null;
            }

            const clientX = e.changedTouches ? e.changedTouches[0].clientX : e.clientX;
            const clientY = e.changedTouches ? e.changedTouches[0].clientY : e.clientY;

            const canvasRect = currentHanziWriter.canvas.getBoundingClientRect();
            if (clientX >= canvasRect.left && clientX <= canvasRect.right &&
                clientY >= canvasRect.top && clientY <= canvasRect.bottom) {
                
                const success = currentHanziWriter.checkPuzzleDrop(idx, { x: clientX, y: clientY });
                if (success) {
                    pieceDiv.style.display = 'none'; 
                }
            }
        };

        pieceDiv.addEventListener('mousedown', startDrag);
        document.addEventListener('mousemove', moveClone);
        document.addEventListener('mouseup', endDrag);

        pieceDiv.addEventListener('touchstart', startDrag, { passive: false });
        document.addEventListener('touchmove', moveClone, { passive: false });
        document.addEventListener('touchend', endDrag);

        puzzleContainer.appendChild(pieceDiv);
    });
