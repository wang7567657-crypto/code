                            </div>
                        `;

                        // --- 修改開始：檢查是否已有預先生成的題目 ---
                        let quizData = item.clozeQuizData;
                        
                        if (!quizData && item.clozeQuizPromise) {
                            // 如果還在生成中，等待它完成
                            try {
                                quizData = await item.clozeQuizPromise;
                            } catch (error) {
                                console.error("背景出題失敗:", error);
                            }
                        } else if (!quizData) {
                            // 如果完全沒觸發過（不應該發生，但作為保險），現場生成
                            let allPhrases = [item.phrase];
