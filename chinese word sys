                                logEntry.textContent = `[${job.item.char}] - 安全模式失敗 ✗ (第 ${attempt} 次)`;
                                logEntry.className = 'text-red-400';
                                logEntry.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            }
                            if (attempt < MAX_SAFE_ATTEMPTS) await new Promise(r => setTimeout(r, 1000));
                        }

                        // 兩階段都失敗
                        logEntry.textContent = `[${job.item.char}] - 最終失敗 ✗`;
                        logEntry.className = 'text-red-500 font-bold';
                        logEntry.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    };

                    // --- 修改開始：改為滑動視窗執行 (Sliding Window Concurrency) ---
                    const CONCURRENCY_LIMIT = 10;
                    let completedCount = 0;
                    const totalItems = itemsToProcess.length;
                    
                    loadingText.textContent = `正在生成圖片 (進度 0/${totalItems})...`;

                    const runJob = async (job) => {
                        await generateImageForItemWithRetries(job);
                        completedCount++;
                        loadingText.textContent = `正在生成圖片 (進度 ${completedCount}/${totalItems})...`;
                    };

                    const activePromises = [];
                    
                    for (const job of itemsToProcess) {
                        const p = runJob(job);
                        
                        // 當這個任務完成後，將自己從 activePromises 中移除
                        // 注意：我們 push 進去的是 p.then(...) 回傳的新 Promise
                        const itemPromise = p.then(() => {
                            activePromises.splice(activePromises.indexOf(itemPromise), 1);
                        });
                        
                        activePromises.push(itemPromise);
                        
                        // 如果達到併發上限，等待其中一個完成
                        if (activePromises.length >= CONCURRENCY_LIMIT) {
                            await Promise.race(activePromises);
                        }
                    }
                    
                    // 等待剩下的所有任務完成
                    await Promise.all(activePromises);
                    // --- 修改結束 ---

                    // After all jobs are done (either success or all retries failed), find the ones that failed.
                    const failedItems = itemsToProcess
                        .filter(job => !quizItems[job.index].imageUrl)
