                            // 用 Regex 將括號分割，保留分割點以便插入 Drop Zone
                            const textSegments = (quizData.question || "").split(/（\s*）|\(\s*\)/);
                            let questionWithDropZone = "";

                            textSegments.forEach((segment, index) => {
