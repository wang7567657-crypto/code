                    const buffer = new Uint8Array([high, low]);
                    if (decoder.decode(buffer) === targetChar) {
                        const hex = (high.toString(16) + low.toString(16)).toLowerCase();
                        big5Cache[targetChar] = hex;
                        return hex;
                    }
                }
            }
            return null;
        };

        class TaiwanStrokeWriter {
            constructor(containerId, character, options = {}) {
                this.container = document.getElementById(containerId);
                this.width = options.width || 400;
                this.height = options.height || 400;
                this.scaleX = this.width / 2048;
                this.scaleY = this.height / 2048;
                
                // 清空容器並建立 Canvas
                this.container.innerHTML = '';
                this.canvas = document.createElement('canvas');
                this.canvas.width = this.width;
                this.canvas.height = this.height;
                this.canvas.className = 'absolute inset-0 z-10 touch-none select-none';
                this.container.appendChild(this.canvas);
                this.ctx = this.canvas.getContext('2d');

                // 狀態變數
                this.character = character;
                this.strokesData = [];
                this.mode = 'play'; // 'play', 'practice', 'puzzle'
                this.showOutline = options.showOutline !== false;
                this.showHint = true;
                this.currentStrokeNum = 0;
                this.userPath = [];
                this.feedback = null;
                this.playDelay = 800;
                this.isPlaying = false;
                this.playTimer = null;
                this.isDrawing = false;
                
                // 配對遊戲變數
                this.hiddenStrokes = [];
                this.placedStrokes = [];
                this.onPuzzleComplete = options.onPuzzleComplete || null;

                // 綁定事件
                this.handlePointerDown = this.handlePointerDown.bind(this);
                this.handlePointerMove = this.handlePointerMove.bind(this);
                this.handlePointerUp = this.handlePointerUp.bind(this);
                
                this.canvas.addEventListener('pointerdown', this.handlePointerDown);
                this.canvas.addEventListener('pointermove', this.handlePointerMove);
                this.canvas.addEventListener('pointerup', this.handlePointerUp);
                this.canvas.addEventListener('pointercancel', this.handlePointerUp);

                this.showLoading();
                this.loadCharacterData();
            }

            showLoading() {
                this.ctx.clearRect(0, 0, this.width, this.height);
                this.ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
                this.ctx.fillRect(0, 0, this.width, this.height);
                this.ctx.fillStyle = '#64748b';
                this.ctx.font = '16px Inter, sans-serif';
                this.ctx.textAlign = 'center';
                this.ctx.fillText('載入筆順資料中...', this.width / 2, this.height / 2);
            }

            showError(msg) {
                this.ctx.clearRect(0, 0, this.width, this.height);
                this.ctx.fillStyle = 'rgba(254, 226, 226, 0.8)';
                this.ctx.fillRect(0, 0, this.width, this.height);
                this.ctx.fillStyle = '#b91c1c';
                this.ctx.font = '16px Inter, sans-serif';
                this.ctx.textAlign = 'center';
                this.ctx.fillText(msg, this.width / 2, this.height / 2);
            }

            async loadCharacterData() {
                try {
                    const big5Hex = getBig5Hex(this.character);
                    if (!big5Hex) throw new Error('無法解析編碼');
                    const url = `https://cdn.jsdelivr.net/gh/c9s/zh-stroke-data@master/data/${big5Hex}.xml`;
                    const response = await fetch(url);
                    if (!response.ok) throw new Error('查無資料');
                    
                    const xmlText = await response.text();
                    const xmlDoc = new DOMParser().parseFromString(xmlText, "text/xml");
                    if (xmlDoc.getElementsByTagName("parsererror").length > 0) throw new Error("XML 解析失敗");
                    
                    const strokeNodes = xmlDoc.getElementsByTagName('Stroke');
                    if (strokeNodes.length === 0) throw new Error('此字無資料');

                    this.strokesData = Array.from(strokeNodes).map((strokeNode) => {
                        const outline = strokeNode.getElementsByTagName('Outline')[0];
                        const track = strokeNode.getElementsByTagName('Track')[0];
                        
                        let pathString = '';
                        if (outline) {
                            Array.from(outline.children).forEach(node => {
                                const tag = node.tagName.toLowerCase();
                                if (tag === 'moveto') pathString += `M ${node.getAttribute('x')} ${node.getAttribute('y')} `;
                                else if (tag === 'lineto') pathString += `L ${node.getAttribute('x')} ${node.getAttribute('y')} `;
                                else if (tag === 'quadto') pathString += `Q ${node.getAttribute('x1')} ${node.getAttribute('y1')} ${node.getAttribute('x2')} ${node.getAttribute('y2')} `;
                                else if (tag === 'cubicto') pathString += `C ${node.getAttribute('x1')} ${node.getAttribute('y1')} ${node.getAttribute('x2')} ${node.getAttribute('y2')} ${node.getAttribute('x3')} ${node.getAttribute('y3')} `;
                                else if (tag === 'point') pathString += (pathString.length === 0 ? 'M' : 'L') + ` ${node.getAttribute('x')} ${node.getAttribute('y')} `;
                            });
                        }
                        
                        let median = [];
                        const targetNodeForMedian = track || outline; 
                        if (targetNodeForMedian) {
                            Array.from(targetNodeForMedian.children).forEach(node => {
                                let pts = [];
                                if (node.hasAttribute('x')) pts.push({ x: parseFloat(node.getAttribute('x')), y: parseFloat(node.getAttribute('y')) });
                                if (node.hasAttribute('x1')) pts.push({ x: parseFloat(node.getAttribute('x1')), y: parseFloat(node.getAttribute('y1')) });
                                if (node.hasAttribute('x2')) pts.push({ x: parseFloat(node.getAttribute('x2')), y: parseFloat(node.getAttribute('y2')) });
                                if (node.hasAttribute('x3')) pts.push({ x: parseFloat(node.getAttribute('x3')), y: parseFloat(node.getAttribute('y3')) });
                                pts.forEach(pt => {
                                    if (!isNaN(pt.x) && !isNaN(pt.y)) {
                                        median.push({ x: (pt.x * this.scaleX), y: (pt.y * this.scaleY) });
                                    }
                                });
                            });
                        }
                        return { pathString: pathString.trim(), median: median };
                    });

                    if (this.mode === 'play') {
                        this.currentStrokeNum = 0; // 如果是播放模式，載入完畢保持清空
                    } else {
                        this.currentStrokeNum = this.strokesData.length;
                    }
                    this.render();
                } catch (err) {
                    this.showError(`找不到「${this.character}」的資料`);
                    this.strokesData = [];
                }
            }

            render() {
                if (this.strokesData.length === 0) return;
                
                this.ctx.clearRect(0, 0, this.width, this.height);
                this.ctx.save();
                
                // 👉 加入這行！將 2048 的 SVG 座標縮放到目前的畫布大小
                this.ctx.scale(this.width / 2048, this.height / 2048);
                
                if (this.showOutline) {
                    this.ctx.fillStyle = '#cbd5e1'; 
                    this.strokesData.forEach(s => this.ctx.fill(new Path2D(s.pathString)));
                }
                
                this.ctx.fillStyle = '#111827'; 
                if (this.mode === 'puzzle') {
                    this.strokesData.forEach((s, i) => {
                        if (!this.hiddenStrokes.includes(i) || this.placedStrokes.includes(i)) {
                            this.ctx.fill(new Path2D(s.pathString));
                        }
                    });
                } else {
                    for (let i = 0; i < this.currentStrokeNum; i++) {
                        if (this.strokesData[i]) {
                            this.ctx.fill(new Path2D(this.strokesData[i].pathString));
                        }
                    }
                }
                this.ctx.restore();

                if (this.mode === 'practice' && this.currentStrokeNum < this.strokesData.length && this.showHint) {
                    const targetMedian = this.strokesData[this.currentStrokeNum].median;
                    if (targetMedian.length > 0) {
                        this.ctx.beginPath();
                        this.ctx.arc(targetMedian[0].x, targetMedian[0].y, 8, 0, Math.PI * 2);
                        this.ctx.fillStyle = '#ef4444';
                        this.ctx.fill();
                        
                        this.ctx.beginPath();
                        this.ctx.moveTo(targetMedian[0].x, targetMedian[0].y);
                        for (let i = 1; i < targetMedian.length; i++) {
                            this.ctx.lineTo(targetMedian[i].x, targetMedian[i].y);
                        }
                        this.ctx.strokeStyle = 'rgba(252, 165, 165, 0.5)';
                        this.ctx.lineWidth = 6;
                        this.ctx.lineCap = 'round';
                        this.ctx.lineJoin = 'round';
                        this.ctx.stroke();
                    }
                }

                if (this.userPath.length > 0) {
                    this.ctx.beginPath();
                    this.ctx.moveTo(this.userPath[0].x, this.userPath[0].y);
                    for (let i = 1; i < this.userPath.length; i++) {
                        this.ctx.lineTo(this.userPath[i].x, this.userPath[i].y);
                    }
                    this.ctx.strokeStyle = this.feedback === 'error' ? '#ef4444' : '#3b82f6';
                    this.ctx.lineWidth = 6;
                    this.ctx.lineCap = 'round';
                    this.ctx.lineJoin = 'round';
                    this.ctx.stroke();
                }

                if (this.feedback) {
                    this.ctx.save();
                    this.ctx.translate(this.width / 2, this.height / 2);
                    this.ctx.fillStyle = this.feedback === 'success' ? 'rgba(34, 197, 94, 0.8)' : 'rgba(239, 68, 68, 0.8)';
                    this.ctx.beginPath();
                    this.ctx.arc(0, 0, 40, 0, Math.PI * 2);
                    this.ctx.fill();
                    this.ctx.fillStyle = 'white';
                    this.ctx.font = 'bold 40px sans-serif';
                    this.ctx.textAlign = 'center';
                    this.ctx.textBaseline = 'middle';
                    this.ctx.fillText(this.feedback === 'success' ? '✓' : '✗', 0, 2);
                    this.ctx.restore();
                }
            }

            setCharacter(char) {
                this.character = char;
                this.cancelQuiz();
                this.showLoading();
                this.loadCharacterData();
            }

            animateCharacter() {
                this.mode = 'play';
                this.currentStrokeNum = 0;
                this.isPlaying = true;
                this.playNextStroke();
            }

            animateStroke(step) {
                this.mode = 'play';
                this.isPlaying = false;
                clearTimeout(this.playTimer);
                this.currentStrokeNum = Math.min(step + 1, this.strokesData.length);
                this.render();
            }

            playNextStroke() {
                if (!this.isPlaying || this.mode !== 'play') return;
                this.render();
                if (this.currentStrokeNum < this.strokesData.length) {
                    this.playTimer = setTimeout(() => {
                        this.currentStrokeNum++;
                        this.playNextStroke();
                    }, this.playDelay);
                } else {
                    this.isPlaying = false;
                }
            }

            quiz() {
                this.mode = 'practice';
                this.currentStrokeNum = 0;
                this.userPath = [];
                this.feedback = null;
                this.isPlaying = false;
                clearTimeout(this.playTimer);
                this.render();
            }

            cancelQuiz() {
                this.mode = 'play';
                this.currentStrokeNum = this.strokesData.length;
                this.userPath = [];
                this.feedback = null;
                this.isPlaying = false;
                clearTimeout(this.playTimer);
                this.render();
            }

            hideCharacter() { this.currentStrokeNum = 0; this.render(); }
            showCharacter() { this.currentStrokeNum = this.strokesData.length; this.render(); }

            getCanvasPoint(e) {
                const rect = this.canvas.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return {
                    x: (clientX - rect.left) * (this.width / rect.width),
                    y: (clientY - rect.top) * (this.height / rect.height)
                };
            }

            handlePointerDown(e) {
                if (this.mode !== 'practice' || this.currentStrokeNum >= this.strokesData.length) return;
                e.preventDefault();
                try { e.currentTarget.setPointerCapture(e.pointerId); } catch(err) {}
                this.isDrawing = true;
                this.feedback = null;
                this.userPath = [this.getCanvasPoint(e)];
                this.render();
            }

            handlePointerMove(e) {
                if (!this.isDrawing) return;
                e.preventDefault();
                this.userPath.push(this.getCanvasPoint(e));
                this.render();
            }

            handlePointerUp(e) {
                if (!this.isDrawing) return;
                e.preventDefault();
                this.isDrawing = false;
                try { e.currentTarget.releasePointerCapture(e.pointerId); } catch(err) {}
                this.evaluateUserStroke();
            }

            evaluateUserStroke() {
                if (this.userPath.length < 3) {
                    this.userPath = []; this.render(); return;
                }

                const targetMedian = this.strokesData[this.currentStrokeNum].median;
                if (targetMedian.length < 2) { this.triggerSuccess(); return; }

                const distance = (p1, p2) => Math.sqrt(Math.pow(p1.x - p2.x, 2) + Math.pow(p1.y - p2.y, 2));
                const pointToSegmentDistance = (p, v, w) => {
                    const l2 = Math.pow(v.x - w.x, 2) + Math.pow(v.y - w.y, 2);
                    if (l2 === 0) return distance(p, v);
                    let t = ((p.x - v.x) * (w.x - v.x) + (p.y - v.y) * (w.y - v.y)) / l2;
                    t = Math.max(0, Math.min(1, t));
                    return distance(p, { x: v.x + t * (w.x - v.x), y: v.y + t * (w.y - v.y) });
                };

                const START_TOLERANCE = 40 * (this.width / 280); 
                const END_TOLERANCE = 40 * (this.width / 280);
                const PATH_TOLERANCE = 35 * (this.width / 280);

                if (distance(this.userPath[0], targetMedian[0]) > START_TOLERANCE || 
                    distance(this.userPath[this.userPath.length - 1], targetMedian[targetMedian.length - 1]) > END_TOLERANCE) {
                    this.triggerError(); return;
                }

                const isPathValid = this.userPath.every(userPt => {
                    let minDistance = Infinity;
                    for (let i = 0; i < targetMedian.length - 1; i++) {
                        const dist = pointToSegmentDistance(userPt, targetMedian[i], targetMedian[i + 1]);
                        if (dist < minDistance) minDistance = dist;
                    }
                    return minDistance < PATH_TOLERANCE;
                });

                if (!isPathValid) { this.triggerError(); return; }
                this.triggerSuccess();
            }

            triggerSuccess() {
                this.feedback = 'success'; this.render();
                setTimeout(() => {
                    this.currentStrokeNum++; this.userPath = []; this.feedback = null; this.render();
                }, 300);
            }

            triggerError() {
                this.feedback = 'error'; this.render();
                setTimeout(() => {
                    this.userPath = []; this.feedback = null; this.render();
                }, 400);
            }

            startPuzzle(numPieces = 3) {
                this.cancelQuiz();
                this.mode = 'puzzle';
                if (this.strokesData.length === 0) return [];
                const hideCount = Math.min(numPieces, this.strokesData.length);
                
                let indices = Array.from({ length: this.strokesData.length }, (_, i) => i);
                indices.sort(() => Math.random() - 0.5);
                this.hiddenStrokes = indices.slice(0, hideCount).sort((a, b) => a - b);
                this.placedStrokes = [];
                this.render();
                return this.hiddenStrokes; 
            }

            checkPuzzleDrop(strokeIndex, dropPos) {
                const rect = this.canvas.getBoundingClientRect();
                const pt = {
                    x: (dropPos.x - rect.left) * (this.width / rect.width),
                    y: (dropPos.y - rect.top) * (this.height / rect.height)
                };

                const median = this.strokesData[strokeIndex].median;
                let targetCenterX = this.width / 2, targetCenterY = this.height / 2;
                if (median && median.length > 0) {
                    targetCenterX = median.reduce((sum, p) => sum + p.x, 0) / median.length;
                    targetCenterY = median.reduce((sum, p) => sum + p.y, 0) / median.length;
                }
                
                if (Math.hypot(pt.x - targetCenterX, pt.y - targetCenterY) < 45 * (this.width / 280)) {
                    this.placedStrokes.push(strokeIndex);
                    this.triggerSuccess();
                    if (this.placedStrokes.length === this.hiddenStrokes.length && this.onPuzzleComplete) {
                        setTimeout(() => this.onPuzzleComplete(), 500);
                    }
                    return true;
                } else {
                    this.triggerError();
                    return false;
                }
            }
        }
