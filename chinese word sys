                zCtx.lineJoin = 'round';

                zoomStrokes.forEach(stroke => {
                    zCtx.beginPath();
                    if (stroke.points.length > 0) {
                        zCtx.moveTo(stroke.points[0].x, stroke.points[0].y);
                        for (let i = 1; i < stroke.points.length; i++) {
                            zCtx.lineTo(stroke.points[i].x, stroke.points[i].y);
                        }
                    }
                    
                    zCtx.strokeStyle = stroke.color;
                    zCtx.lineWidth = stroke.width;
                    zCtx.globalCompositeOperation = stroke.tool === 'eraser' ? 'destination-out' : 'source-over';
                    zCtx.stroke();
                });
            }

            function zoomStartDrawing(e) {
