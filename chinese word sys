                                    questionWithDropZone += `<span class="cloze-drop-zone inline-flex items-center justify-center min-w-[100px] h-[45px] border-b-4 border-dashed border-gray-500 mx-2 text-blue-500 bg-gray-100 rounded px-3 transition-all align-middle text-lg font-normal" data-expected="${expectedAnswer}">？</span>`;
