            function parseBopomofoStructured(bopomofoStr) {
                if (!bopomofoStr) return null;
                let remaining = bopomofoStr;
                const result = { initial: null, medial: null, final: null, tone: '' };
                const lastChar = remaining.slice(-1);
                if (BOPOMOFO_TONES.includes(lastChar)) { result.tone = lastChar; remaining = remaining.slice(0, -1); } 
                else if (lastChar === '˙') { result.tone = '˙'; remaining = remaining.slice(0, -1); }
                if (BOPOMOFO_INITIALS.includes(remaining[0])) { result.initial = remaining[0]; remaining = remaining.slice(1); }
                if (BOPOMOFO_MEDIALS.includes(remaining[0])) { result.medial = remaining[0]; remaining = remaining.slice(1); }
                if (remaining.length > 0) { result.final = remaining; }
