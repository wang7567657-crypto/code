            // --- 新增：語音播放與高亮控制函式 ---
            let currentHighlightElement = null;
            let currentSpeechId = 0; // 新增：用於追蹤當前語音序列的 ID

            function speakSequence(text, elementToHighlight = null) {
                if (!text) return;

                // 增加 ID，標記這是一次新的播放請求
                const thisSpeechId = ++currentSpeechId;

                // 1. 取消正在播放的語音
                window.speechSynthesis.cancel();

                // 2. 清除舊的高亮
                if (currentHighlightElement) {
                    currentHighlightElement.classList.remove('reading-highlight');
                    currentHighlightElement = null;
                }

                // 3. 設定新的高亮
                if (elementToHighlight) {
                    currentHighlightElement = elementToHighlight;
                    currentHighlightElement.classList.add('reading-highlight');
                }

                // 4. 分割句子 (依照標點符號，但保留標點以維持語氣)
                // regex: 匹配一段文字後接著任意標點，或是字串結尾
                // 修改：增加對半形標點符號 (,.;:?!) 的支援，確保切割更精確
                const segments = text.match(/[^，。、？！；：,.;:?!\s]+[，。、？！；：,.;:?!]?/g) || [text];

                let currentSegmentIndex = 0;

                function playNextSegment() {
                    // 如果 ID 不匹配，表示已經有新的播放請求開始了，舊的流程應停止
                    if (thisSpeechId !== currentSpeechId) return;

                    if (currentSegmentIndex >= segments.length) {
                        // 播放結束，移除高亮
                        // 確保只有當前 ID 匹配時才移除，避免移除了新請求設定的高亮
                        if (thisSpeechId === currentSpeechId && currentHighlightElement) {
                            currentHighlightElement.classList.remove('reading-highlight');
                            currentHighlightElement = null;
                        }
                        return;
                    }

                    const segmentText = segments[currentSegmentIndex];
                    const utterance = new SpeechSynthesisUtterance(segmentText);
                    utterance.lang = 'zh-TW';
                    utterance.rate = globalSpeechRate; // 修改：使用全域語速變數
                    if (googleZHTWVoice) utterance.voice = googleZHTWVoice;

                    utterance.onend = () => {
                        // 確保 ID 匹配才繼續
                        if (thisSpeechId === currentSpeechId) {
                            currentSegmentIndex++;
                            playNextSegment();
                        }
                    };

                    utterance.onerror = (e) => {
                        // 確保 ID 匹配才處理錯誤，避免因 cancel() 觸發舊的 error handler 而移除新高亮
                        if (thisSpeechId === currentSpeechId) {
                            console.error("Speech synthesis error:", e);
                            if (currentHighlightElement) {
                                currentHighlightElement.classList.remove('reading-highlight');
                                currentHighlightElement = null;
                            }
                        }
                    };

                    window.speechSynthesis.speak(utterance);
                }

                playNextSegment();
            }

            // 新增函式：將文字依標點符號切分為可點擊的 span
            function createClickableSegments(text, additionalClasses = "") {
                if (!text) return '';
                // Regex 匹配：非標點符號的連續文字 + 選擇性的標點符號
                // 修改：增加對半形標點符號 (,.;:?!) 的支援，確保切割更精確
                const segments = text.match(/[^，。、？！；：,.;:?!\s]+[，。、？！；：,.;:?!]?/g) || [text];
                
                return segments.map(segment => {
                    const safeText = segment.replace(/"/g, '&quot;');
                    // 注意：這裡統一使用 data-role="read-text" 以便與 speakSequence 整合
                    return `<span class="clickable-text hover:text-blue-600 transition-colors rounded px-1 ${additionalClasses}" data-role="read-text" data-text="${safeText}">${segment}</span>`;
                }).join('');
            }

