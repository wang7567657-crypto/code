                                    importedExtraPhrasesCSVData[char] = [];
                                }
                                importedExtraPhrasesCSVData[char].push({
                                    phrase: row[1].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                    bopomofo: row[2].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                    meaning: row[3].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
                                    sentence: row[4].replace(/^"|"$/g, '').replace(/""/g, '"').trim()
                                });
                            }
                        }
                        console.log("成功載入擴充語詞 CSV 資料:", importedExtraPhrasesCSVData);
                    }
                    // 👆 新增結束 👆

                    const text = csvImportTextarea.value.trim();
                    
                    if (!text) {
                        showToast("請輸入 CSV 內容");
                        return;
                    }

// 簡單的 CSV 解析器 (處理換行)
const lines = text.split(/\r?\n/).filter(line => line.trim() !== '');

if (lines.length === 0) {
    showToast("請輸入內容");
    return;
}

// 判斷第一行是否為標題 (檢查是否包含 "生字" 這個詞)
// 如果是標題，就從 index 1 開始讀；如果不是，就從 index 0 開始讀。
let startIndex = 0;
if (lines[0].includes("生字") || lines[0].includes("注音")) {
    startIndex = 1;
}

const recordData = [];
// 使用動態的 startIndex 開始迴圈
for (let i = startIndex; i < lines.length; i++) {
    let row = [];
    
    // ... (這裡保留你原本的 Tab 與逗號解析邏輯，不用動) ...
                        
                        // 動態相容：如果有 Tab 就用 Tab 分割，否則退回原本的逗號解析邏輯
                        if (lines[i].includes('\t')) {
                            row = lines[i].split('\t');
                        } else {
                            let insideQuote = false;
                            let currentVal = "";
                            for (let char of lines[i]) {
                                if (char === '"') insideQuote = !insideQuote;
                                else if (char === ',' && !insideQuote) { row.push(currentVal); currentVal = ""; }
                                else currentVal += char;
                            }
                            row.push(currentVal); // 推入最後一個欄位
                        }

// 確保至少有 6 個欄位才寫入 (配合新增的語詞解釋)
if (row.length >= 6) {
    recordData.push({
        char: row[0].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
        bopomofo: row[1].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
        phrase: row[2].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
        phraseBopomofo: row[3].replace(/^"|"$/g, '').replace(/""/g, '"').trim(),
        meaning: row[4].replace(/^"|"$/g, '').replace(/""/g, '"').trim(), // 第 5 欄：語詞解釋
        sentence: row[5].replace(/^"|"$/g, '').replace(/""/g, '"').trim()  // 第 6 欄：例句
    });
}
                    }

                    if (recordData.length > 0) {
                        // 1. 隱藏匯入視窗與首頁
                        csvImportModal.classList.add('hidden');
                        document.getElementById('home-screen').classList.add('hidden');
                        
                        // 2. 將原始 CSV/TSV 文字直接放入新的預覽文字框中
                        const primaryInput = document.getElementById('primary-tsv-input');
                        const extraInput = document.getElementById('extra-tsv-input');
                        if (primaryInput) primaryInput.value = text;
                        if (extraInput) extraInput.value = extraText;

                        // 3. 更新全域變數 quizChars (供後續存檔或生圖使用)
                        quizChars = recordData.map(item => item.char);
                        lastBatchSelectionEndIndex = -1;

                        // 4. 顯示新的預覽畫面
                        const previewScreen = document.getElementById('preview-screen');
                        const previewButtonsContainer = document.getElementById('preview-buttons-container');
                        previewScreen.classList.remove('hidden');
                        previewButtonsContainer.classList.remove('hidden');

                        // 5. 確保舊版不需要的按鈕隱藏
                        const regeneratePhraseBopomofoBtn = document.getElementById('regenerate-phrase-bopomofo-btn');
                        if (regeneratePhraseBopomofoBtn) regeneratePhraseBopomofoBtn.classList.add('hidden');

                        showToast("CSV 匯入成功！請確認內容後開始測驗。");
                    } else {
                        showToast("無法解析 CSV 內容，請確認格式。");
                    }
                });
            }

            if (swapPanelsBtn) {
                swapPanelsBtn.addEventListener('click', () => {
                    const quizGridContainer = document.getElementById('quiz-grid-container');
                    if (quizGridContainer && quizGridContainer.firstElementChild) {
                        // 將第一個面板移動到容器的末尾，即可交換位置
                        quizGridContainer.appendChild(quizGridContainer.firstElementChild);
                    }
                });
            }

            // 新增：語速拉桿事件監聽
            const speechRateSlider = document.getElementById('speech-rate-slider');
            const speechRateDisplay = document.getElementById('speech-rate-display');
            if (speechRateSlider) {
                speechRateSlider.addEventListener('change', (e) => {
                    globalSpeechRate = parseFloat(e.target.value);
                    if(speechRateDisplay) speechRateDisplay.textContent = globalSpeechRate;
                    savePreferencesToFirestore(); // 存入 Firebase
                    speak('語速已調整'); // 測試播放
                });
            }

            // 新增：AI 客製化修改指令的邏輯 (左右獨立)
            async function handleAiModification(inputId, btnId, targetTextareaId, contextName) {
                const inputEl = document.getElementById(inputId);
                const btnEl = document.getElementById(btnId);
                const textareaEl = document.getElementById(targetTextareaId);
                
                if (!inputEl || !btnEl || !textareaEl) return;

                const executeModify = async () => {
                    const prompt = inputEl.value.trim();
                    if (!prompt) { showToast('請先輸入修改指令！'); return; }

                    const currentData = textareaEl.value;
                    btnEl.disabled = true;
                    btnEl.textContent = 'AI 修改中...';

                    const apiKey = ""; // 共用全域 API Key
                    const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
                    
                    const systemPrompt = `你是一個專業的中文特教老師。以下是目前的「${contextName}」（TSV格式）。
請根據使用者的「修改指令」來調整這份資料。
請務必「直接」回傳修改後的完整 TSV 文字內容，不要使用 Markdown 程式碼區塊標記。

【目前資料】
${currentData}

【使用者的修改指令】
${prompt}`;

                    const payload = { contents: [{ parts: [{ text: systemPrompt }] }] };

                    // --- 修改：加入最多 3 次的重試迴圈 ---
                    for (let attempt = 1; attempt <= 3; attempt++) {
                        try {
                            if (attempt > 1) btnEl.textContent = `AI 修改中 (重試 ${attempt}/3)...`;

                            const response = await fetch(apiUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                            if (!response.ok) throw new Error(`API request failed`);
                            const result = await response.json();
                            let text = result.candidates?.[0]?.content?.parts?.[0]?.text || "";
                            
                            if (text) {
                                // 清除可能帶有的 Markdown 標記，以防萬一
                                text = text.replace(/```[a-zA-Z]*\n?/g, '').replace(/```/g, '').trim();
                                textareaEl.value = text;
                                showToast('AI 修改完成！');
                                inputEl.value = ''; // 清空輸入框
                                break; // 成功跳出迴圈
                            } else {
                                throw new Error('API 回傳內容為空');
                            }
                        } catch (error) {
                            console.error(`AI Modify Error (第 ${attempt} 次):`, error);
                            if (attempt === 3) {
                                showToast('AI 修改失敗，請稍後再試。');
                            } else {
                                // 失敗後等待一段時間再重試
                                await new Promise(resolve => setTimeout(resolve, 1000 * attempt));
                            }
                        }
                    }
                    
                    // 迴圈結束後（無論成功或徹底失敗）恢復按鈕狀態
                    btnEl.disabled = false;
                    btnEl.textContent = '請 AI 修改';
                };

                btnEl.addEventListener('click', executeModify);
                // 支援按 Shift + Enter 送出，一般 Enter 則用來換行
                inputEl.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && e.shiftKey) {
                        e.preventDefault(); // 阻止預設的換行行為
                        executeModify();
                    }
                });
            }

            // 綁定左半部 (基礎教材) 的按鈕
            handleAiModification('primary-ai-modify-input', 'primary-ai-modify-btn', 'primary-tsv-input', '生字基礎教材');
            // 綁定右半部 (擴充教材) 的按鈕
            handleAiModification('extra-ai-modify-input', 'extra-ai-modify-btn', 'extra-tsv-input', '生字擴充語詞教材');

        });
    </script>
