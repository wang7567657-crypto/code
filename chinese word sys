            function selectBatch(batchSize) {
                const checkboxes = Array.from(charSelectionContainer.querySelectorAll('input[type="checkbox"]'));
                if (checkboxes.length === 0) return;

                checkboxes.forEach(cb => cb.checked = false);

                let startIndex = lastBatchSelectionEndIndex + 1;
                if (startIndex >= checkboxes.length) {
                    startIndex = 0; // Wrap around to the start if we've reached the end
                }

                const endIndex = startIndex + batchSize;
                let newLastIndex = -1;
                let firstSelectedIndex = -1;

                for (let i = startIndex; i < endIndex && i < checkboxes.length; i++) {
                    checkboxes[i].checked = true;
                    if (firstSelectedIndex === -1) {
                        firstSelectedIndex = i;
                    }
                    newLastIndex = i;
                }
                
                lastBatchSelectionEndIndex = newLastIndex;

                // Scroll the first newly selected item into view
                if (firstSelectedIndex !== -1) {
                    const firstSelectedElement = checkboxes[firstSelectedIndex].parentElement;
                    if (firstSelectedElement) {
                        firstSelectedElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'nearest'
                        });
                    }
                }
            }
            
            // --- 寫字練習 Canvas 邏輯 ---
            function initializePracticeCanvas() {
                const parent = practiceCanvas.parentElement;
                if (!parent || parent.clientWidth <= 0) return;
