            const BOPOMOFO_TONES = ['ˊ', 'ˇ', 'ˋ', '˙'];

            function getTonePracticeParts(bopomofoStr) {
                const structured = parseBopomofoStructured(bopomofoStr);
                if (!structured) return { basePart: '', correctTonedPart: '' };

                if (structured.final) {
                    return { basePart: structured.final, correctTonedPart: structured.final + structured.tone };
                }
                if (structured.medial) {
                    return { basePart: structured.medial, correctTonedPart: structured.medial + structured.tone };
                }
                if (structured.initial) {
                    return { basePart: structured.initial, correctTonedPart: structured.initial + structured.tone };
                }
                return { basePart: '', correctTonedPart: '' };
            }

            function generateToneVariations(bopomofoFinal) {
                if (!bopomofoFinal) return [];
                // 移除現有的聲調符號以取得基本音
                const baseFinal = bopomofoFinal.replace(/[ˊˇˋ˙]/g, '');
                if (!baseFinal) return [];

                return [
                    baseFinal,          // 一聲
                    baseFinal + 'ˊ',    // 二聲
                    baseFinal + 'ˇ',    // 三聲
                    baseFinal + 'ˋ',    // 四聲
                    baseFinal + '˙'     // 輕聲
                ];
            }
            
            function parseBopomofo(bopomofoStr) {
                if (!bopomofoStr) return [];
                let remaining = bopomofoStr;
                const components = [];
                let tone = '';

                if (BOPOMOFO_TONES.includes(remaining.slice(-1))) {
                    tone = remaining.slice(-1);
                    remaining = remaining.slice(0, -1);
                } else if (remaining.slice(-1) === '˙') {
                    tone = '˙';
                    remaining = remaining.slice(0, -1);
                }

                if (BOPOMOFO_INITIALS.includes(remaining[0])) {
                    components.push(remaining[0]);
                    remaining = remaining.slice(1);
                }

                if (BOPOMOFO_MEDIALS.includes(remaining[0])) {
                    components.push(remaining[0]);
                    remaining = remaining.slice(1);
                }
                
                if (remaining.length > 0) {
                    components.push(remaining);
                }

                if (tone) {
                    const lastComponent = components[components.length - 1];
                    if (lastComponent) {
                         components[components.length - 1] = lastComponent + tone;
                    }
                }
                return components;
            }

            function getSpellingPlaylist(bopomofoStr) {
