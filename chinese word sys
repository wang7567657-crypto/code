                practiceCanvas.height = parent.clientHeight;
                practiceStrokes = [];
                clearPracticeCanvas();
            }

            function drawPracticeGuides() {
                pCtx.save();
                const boxWidth = practiceCanvas.width / 2 - 10;
                const boxHeight = practiceCanvas.height - 10;
                const gap = 20;
                pCtx.strokeStyle = 'black'; pCtx.lineWidth = 2;
                pCtx.strokeRect(5, 5, boxWidth, boxHeight);
                pCtx.strokeRect(5 + boxWidth + gap, 5, boxWidth, boxHeight);
                pCtx.setLineDash([6, 6]); pCtx.strokeStyle = 'rgba(209, 213, 219, 0.8)'; pCtx.lineWidth = 1;
                pCtx.beginPath(); pCtx.moveTo(5, 5 + boxHeight / 2); pCtx.lineTo(5 + boxWidth, 5 + boxHeight / 2); pCtx.moveTo(5 + boxWidth / 2, 5); pCtx.lineTo(5 + boxWidth / 2, 5 + boxHeight); pCtx.stroke();
                pCtx.beginPath(); pCtx.moveTo(5 + boxWidth + gap, 5 + boxHeight / 2); pCtx.lineTo(5 + boxWidth + gap + boxWidth, 5 + boxHeight / 2); pCtx.moveTo(5 + boxWidth + gap + boxWidth / 2, 5); pCtx.lineTo(5 + boxWidth + gap + boxWidth / 2, 5 + boxHeight); pCtx.stroke();
                pCtx.restore();
            }
            
            function redrawPracticeStrokes() {
                pCtx.clearRect(0, 0, practiceCanvas.width, practiceCanvas.height);
                drawPracticeGuides();
                practiceStrokes.forEach(stroke => {
                    pCtx.beginPath();
                    pCtx.moveTo(stroke.points[0].x, stroke.points[0].y);
                    pCtx.strokeStyle = stroke.color;
                    pCtx.lineWidth = stroke.width;
                    pCtx.globalCompositeOperation = stroke.tool === 'eraser' ? 'destination-out' : 'source-over';
                    pCtx.lineCap = 'round'; pCtx.lineJoin = 'round';
                    for (let i = 1; i < stroke.points.length; i++) { pCtx.lineTo(stroke.points[i].x, stroke.points[i].y); }
                    pCtx.stroke();
                });
            }

            function clearPracticeCanvas() { practiceStrokes = []; pCtx.clearRect(0, 0, practiceCanvas.width, practiceCanvas.height); drawPracticeGuides(); }
            function undoPracticeStroke() { if (practiceStrokes.length > 0) { practiceStrokes.pop(); redrawPracticeStrokes(); } }
            const getMousePos = (e, targetCanvas) => { const r = targetCanvas.getBoundingClientRect(); const sX = targetCanvas.width / r.width; const sY = targetCanvas.height / r.height; const t = e.touches?.[0]; return { x: ((t ? t.clientX : e.clientX) - r.left) * sX, y: ((t ? t.clientY : e.clientY) - r.top) * sY }; };
            function practiceStartDrawing(e) {
                e.preventDefault(); isPracticeDrawing = true;
                const { x, y } = getMousePos(e, practiceCanvas);
                pCtx.beginPath(); pCtx.moveTo(x, y);
                const newStroke = { points: [{x, y}], color: currentPracticeColor, width: currentPracticeTool === 'eraser' ? 30 : currentPracticeWidth, tool: currentPracticeTool };
                practiceStrokes.push(newStroke);
                pCtx.strokeStyle = newStroke.color; pCtx.lineWidth = newStroke.width;
                pCtx.globalCompositeOperation = newStroke.tool === 'eraser' ? 'destination-out' : 'source-over';
                pCtx.lineCap = 'round'; pCtx.lineJoin = 'round';
            }
            function practiceDraw(e) {
                if (!isPracticeDrawing) return; e.preventDefault();
                const { x, y } = getMousePos(e, practiceCanvas);
                pCtx.lineTo(x, y); pCtx.stroke();
                if (practiceStrokes.length > 0) { practiceStrokes[practiceStrokes.length - 1].points.push({x, y}); }
            }
            function practiceStopDrawing(e) { if (!isPracticeDrawing) return; e.preventDefault(); pCtx.closePath(); isPracticeDrawing = false; }

