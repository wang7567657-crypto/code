                // 拖曳結束時，一律移除視覺複製品
                if (touchClone) {
                    touchClone.remove();
                    touchClone = null;
                }
                
                // 如果放開手指時不在有效的放置區，就重設所有狀態
                if (!draggedElement || !currentDropZone) {
                    if (draggedElement) draggedElement.style.opacity = '1';
                    if (currentDropZone) currentDropZone.classList.remove('drag-over');
                    draggedElement = null;
                    currentDropZone = null;
                    return;
                }

                const droppedId = draggedElement.dataset.id;
                // 檢查是否配對成功
                if (droppedId === currentDropZone.dataset.id) {
                    playCorrectSound();
                    currentDropZone.innerHTML = draggedElement.innerHTML;
                    currentDropZone.classList.add('matched', 'bg-green-100', 'dark:bg-green-900/50');
