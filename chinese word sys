                let allFolders = Object.keys(groups);
                let sorted = [...new Set([...folderOrder, ...allFolders])].filter(f => allFolders.includes(f));
                
                const oldIdx = sorted.indexOf(dragged);
                const newIdx = sorted.indexOf(target);
                if (oldIdx === -1 || newIdx === -1) return;
                
