                            // --- 緊接在 imagesEl.innerHTML 設定完成後加入這段 ---
                            const quizContainer = imagesEl.querySelector('.cloze-quiz-container');
                            const draggables = quizContainer.querySelectorAll('.cloze-draggable');
                            const dropZones = quizContainer.querySelectorAll('.cloze-drop-zone');
