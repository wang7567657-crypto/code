            function resizeCanvas() {
                const parent = canvas.parentElement;
                if (parent && parent.clientWidth > 0) { canvas.width = parent.clientWidth; canvas.height = parent.clientHeight; redrawStrokes(); }
            }

            function drawGuideLines() {
                ctx.save();
                ctx.strokeStyle = 'rgba(156, 163, 175, 0.5)';
                ctx.lineWidth = 1;
                ctx.setLineDash([6, 6]);
                ctx.beginPath(); ctx.moveTo(0, canvas.height / 2); ctx.lineTo(canvas.width, canvas.height / 2); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(canvas.width / 2, 0); ctx.lineTo(canvas.width / 2, canvas.height); ctx.stroke();
                ctx.restore();
            }

            function redrawStrokes() {
                 ctx.clearRect(0, 0, canvas.width, canvas.height);
                 ctx.fillStyle = 'white'; ctx.fillRect(0, 0, canvas.width, canvas.height);
                 drawGuideLines();
                 ctx.globalCompositeOperation = 'source-over'; ctx.strokeStyle = '#333';
                 ctx.lineWidth = Math.max(3, canvas.width / 120);
                 ctx.lineCap = 'round'; ctx.lineJoin = 'round';
                 strokes.forEach(stroke => {
                     ctx.beginPath(); ctx.moveTo(stroke.points[0].x, stroke.points[0].y);
                     for (let i = 1; i < stroke.points.length; i++) { ctx.lineTo(stroke.points[i].x, stroke.points[i].y); }
                     ctx.stroke();
                 });
            }
            
            function setupContextForTool() {
                if (currentTool === 'eraser') { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = Math.max(20, canvas.width / 20); } 
                else { ctx.globalCompositeOperation = 'source-over'; ctx.strokeStyle = '#333'; ctx.lineWidth = Math.max(3, canvas.width / 120); }
                ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            }

            function clearCanvas() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = 'white'; ctx.fillRect(0, 0, canvas.width, canvas.height);
                drawGuideLines();
                strokes = [];
                resultContainer.innerHTML = '';
                placeholderText.textContent = '尚未辨識';
                resultContainer.appendChild(placeholderText);
                if (isImageQuizMode) { resultsBlock.classList.add('hidden'); generatedImageContainer.classList.remove('hidden'); }
            }

            function undoLastStroke() { if (strokes.length > 0) { strokes.pop(); redrawStrokes(); } }
            function startDrawing(e) { e.preventDefault(); isDrawing = true; setupContextForTool(); const { x, y } = getMousePos(e, canvas); if (currentTool === 'pen') { currentStroke = { points: [{x,y}], color: '#333' }; } ctx.beginPath(); ctx.moveTo(x, y); }
            function draw(e) { if (!isDrawing) return; e.preventDefault(); const { x, y } = getMousePos(e, canvas); if (currentTool === 'pen') { currentStroke.points.push({x, y}); } ctx.lineTo(x, y); ctx.stroke(); }
            function stopDrawing(e) { if (!isDrawing) return; e.preventDefault(); isDrawing = false; if (currentTool === 'pen' && currentStroke.points.length > 1) { strokes.push(currentStroke); } ctx.closePath(); }
            
