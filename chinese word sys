    <script src="https://unpkg.com/@ruffle-rs/ruffle"></script>
    <!-- 引入 Inter 字體 -->
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <style>
        /* 自訂樣式 */
        html {
            font-family: 'Inter', sans-serif;
        }
        /* 讓畫布在觸控設備上有更好的反應 */
        canvas {
            touch-action: none;
        }
        /* 提示訊息動畫 */
        .toast-notification {
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }
        /* 隱藏元素 */
        .hidden {
            display: none;
        }
        /* 辨識結果中被選取的樣式 */
        .candidate-selected {
            background-color: #3b82f6 !important; /* blue-500 */
            color: white !important;
        }
        /* 工具列按鈕啟用時的樣式 */
        .tool-active {
            background-color: #dbeafe; /* blue-100 */
            color: #3b82f6; /* blue-500 */
        }
        .practice-tool-active {
            outline: 2px solid #3b82f6;
            transform: scale(1.1);
        }
        /* 注音拼讀高亮動畫 */
        @keyframes jiggle {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-2px) rotate(-1deg); }
            50% { transform: translateX(2px) rotate(1deg); }
            75% { transform: translateX(-2px) rotate(-1deg); }
        }
        .bopomofo-highlight {
            background-color: #fef08a; /* yellow-200 */
            animation: jiggle 0.3s ease-in-out;
            border-radius: 4px;
            transform-origin: center;
        }
        /* 修改 extra-phrase-card 的樣式，移除原本的 active 狀態顏色，改為更單純的列表樣式，因為圖片固定了 */
        .extra-phrase-card {
            transition: background-color 0.2s;
        }
        .extra-phrase-card:hover {
            background-color: rgba(0, 0, 0, 0.05);
        }
        .dark .extra-phrase-card:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
        
        /* 文字點擊互動樣式 */
        .clickable-text {
            cursor: pointer;
            transition: color 0.2s;
        }
        .clickable-text:hover {
            opacity: 0.7;
        }
        .clickable-phrase:hover { color: #4f46e5; /* indigo-600 */ }
        .dark .clickable-phrase:hover { color: #818cf8; /* indigo-400 */ }
        
        .clickable-bopomofo:hover { color: #d97706; /* amber-600 */ background-color: #fef3c7; /* amber-100 */ border-radius: 4px; }
        .dark .clickable-bopomofo:hover { color: #fbbf24; /* amber-400 */ background-color: #78350f; /* amber-900 */ }

        .clickable-sentence:hover { color: #059669; /* emerald-600 */ }
        .dark .clickable-sentence:hover { color: #34d399; /* emerald-400 */ }

        /* 配對遊戲樣式 */
        .dragging {
            opacity: 0.5;
            transform: scale(1.1);
        }
        .drag-over {
            border-style: dashed;
            border-color: #3b82f6; /* blue-500 */
            transform: scale(1.05);
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        .shake-animation {
            animation: shake 0.5s ease-in-out;
        }
        .tone-practice-btn.correct-tone {
            background-color: #fbcfe8; /* pink-200 */
        }
        .dark .tone-practice-btn.correct-tone {
            background-color: #9d174d; /* pink-800 */
        }
        /* 新增：閱讀時的高亮樣式 */
        .reading-highlight {
            background-color: #fef08a !important; /* yellow-200 */
            transition: background-color 0.2s;
            border-radius: 4px;
            box-shadow: 0 0 0 2px #fef08a; /* 稍微擴大範圍 */
        }
        .dark .reading-highlight {
            background-color: #854d0e !important; /* yellow-800 */
            box-shadow: 0 0 0 2px #854d0e;
            color: #ffffff !important;
        }
        /* 讓括號內的註解看起來可點擊 */
        .clickable-annotation {
            cursor: pointer;
            text-decoration: underline;
            text-decoration-style: dotted;
            text-underline-offset: 4px;
            transition: color 0.2s;
        }
        .clickable-annotation:hover {
            color: #3b82f6;
        }
        /* 新增：圖片放大檢視視窗樣式 */
        #zoom-modal {
            background-color: rgba(0, 0, 0, 0.9);
            /* cursor: zoom-out;  移除這行，因為現在有畫布操作 */
            backdrop-filter: blur(5px);
            /* overflow: auto; 移除這行，改用 flex 佈局 */
        }
        /* 新增：Zoom Modal 內部佈局樣式 */
        #zoom-interface-container {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 16px;
            width: 100%;
            height: 100%;
            padding: 40px;
            position: relative; /* 為 absolute 的工具列定位 */
            z-index: 10; /* 確保內容層級 */
        }
        #zoom-image-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: auto;
            height: 100%;
        }
        #zoom-modal img {
            opacity: 1; 
            max-height: 80vh;
            max-width: 100%;
            display: block;
            background-color: white; 
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            user-select: none;
            -webkit-user-drag: none;
            touch-action: none;
        }
        /* 新增：Hanzi Writer 容器樣式 */
        #hanzi-writer-container {
            width: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        /* 新增：筆畫配對模式的零件樣式 */
        .puzzle-piece {
            transition: all 0.2s ease-out;
            touch-action: none;
        }
        .puzzle-piece.dragging {
            opacity: 0.5;
            transform: scale(1.1);
            transition: none; /* 拖曳時不延遲 */
        }
        /* Zoom 工具列樣式 */
        #zoom-toolbar {
            /* 修改：固定定位在右側，避免被圖片擠壓或跟著放大 */
            position: fixed;
            right: 2rem;
            top: 50%;
            transform: translateY(-50%); /* 垂直置中 */
            
            display: flex;
            flex-direction: column;
            gap: 12px;
            background-color: #f3f4f6;
            padding: 12px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            z-index: 50;
            
            /* 確保工具列不會超出螢幕高度，並可捲動 */
            max-height: 90vh;
            overflow-y: auto;
        }
        .dark #zoom-toolbar {
            background-color: #1f2937;
            border: 1px solid #374151;
        }
        .zoom-tool-btn {
            transition: transform 0.1s;
        }
        .zoom-tool-btn:active {
            transform: scale(0.95);
        }
        .zoom-tool-active {
            outline: 3px solid #3b82f6;
            outline-offset: 2px;
        }
        /* 新增：牛刀小試測驗樣式 */
        .cloze-quiz-container {
            animation: fadeIn 0.3s ease-in-out;
        }
        .cloze-option {
            transition: all 0.2s;
        }
        .cloze-option:hover:not(:disabled) {
            background-color: #f3f4f6;
            transform: translateX(5px);
        }
        .dark .cloze-option:hover:not(:disabled) {
            background-color: #374151;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .feedback-overlay {
            animation: floatUpAndFade 1s forwards ease-out;
        }
        @keyframes floatUpAndFade {
            0% { transform: scale(0.5) translateY(0); opacity: 0; }
            15% { transform: scale(1) translateY(-20px); opacity: 1; }
            70% { transform: scale(1) translateY(-60px); opacity: 1; }
            100% { transform: scale(1) translateY(-100px); opacity: 0; }
        }
        /* 田字格樣式 (用於生成的作業單) */
        /* 加深顏色確保截圖清晰 */
        .tian-zige {
            /* 預設大小，但在 Grid 中會被 override 為 100% */
            width: 100px; 
            height: 100px;
            border: 2px solid #000; /* 加深邊框顏色 */
            position: relative;
            background-color: white;
            box-sizing: border-box;
        }
        /* 使用偽元素作為預設樣式，但在 js 中會使用 inline style 覆蓋以確保截圖成功 */
        .tian-zige::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 1px;
            border-top: 1px dashed #666; 
        }
        .tian-zige::after {
            content: '';
            position: absolute;
            left: 50%;
            top: 0;
            height: 100%;
            width: 1px;
            border-left: 1px dashed #666;
        }
    </style>
</head>
