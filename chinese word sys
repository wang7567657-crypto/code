                    systemContext = `
                        **CORE DIRECTIVE**: Create a PURELY VISUAL, WORDLESS SCENE.
                        
                        **NEGATIVE CONSTRAINTS (CRITICAL)**:
                        - **NO TEXT** of any kind.
                        - **NO** Chinese characters (Hanzi).
                        - **NO** English letters.

                        
                        **ROLE**: You are a Pure Children's Art Illustrator. You specialize in creating montage-style, aesthetic illustrations for children's stories that help children understand the plot of any story and educate them to do well.
                        **TASK**: Visualize the **scenario** described below as a captured moment.
                        **MINDSET**: Focus on atmosphere, lighting, and composition. Do not try to "explain" or "teach" anything. Just paint the scene.
                        **VISUAL DEVICE**: When the sentence conveys a strong feeling, inner state, or dialogue, use a **pictorial thought bubble**. Inside the bubble, include a small illustration that symbolizes the meaning or feeling.
                    `;
                }

                let contentPrompt = "";
                
                // 移除引號，避免 AI 覺得那是需要「寫出來」的字串
                const cleanVocab = vocabulary.replace(/["'“”]/g, "");
                const cleanSentence = sentence.replace(/["'“”]/g, "");

                if (vocabulary.startsWith("Montage:")) {
                    // 如果是蒙太奇模式
                    const content = vocabulary.replace("Montage:", "").trim();
                    if (retryLevel === 1) {
                        contentPrompt = `Scene Description: A composite artistic image showing elements of: ${content}.`;
                    } else if (retryLevel === 2) {
                        contentPrompt = `Scene Description: A collection of cute toy figures representing: ${content}. Simple background.`;
                    } else {
                        contentPrompt = `Scene Description: Minimalist graphic symbols for: ${content}.`;
                    }
                } else {
                    // 一般模式
                    if (retryLevel === 1) {
                        // Level 1: 強調「場景描繪」而非「單字解釋」
                        contentPrompt = `Subject: An artistic scene depicting the concept of ${cleanVocab}.
                        Action/Setting: ${cleanSentence}.
                        Instruction: Show this event happening in a natural environment. 
                        **Specific Directive**: If the sentence involves dialogue or expresses a feeling/state, draw a thought bubble near the character with a mini-illustration inside it to depict the concept.
                        Do not write the word '${cleanVocab}'.`;
                    } else if (retryLevel === 2) {
                        // Level 2: 玩具化嘗試
                        contentPrompt = `Subject: A cute toy figure representing ${cleanVocab}.
                        Setting: A playful toy world scene showing: ${cleanSentence}.
                        Note: If applicable, use a toy-style thought bubble to show what the figure is thinking/feeling.`;
                    } else {
                        // Level 3: 圖標化嘗試
                        contentPrompt = `Subject: A single vector graphic symbol for ${cleanVocab}.
                        Style: Flat design icon. No text.`;
                    }
                }

                // 3. 組合最終 Prompt
                // 將負面提示直接寫在 Prompt 文字最後面，這是最穩定的做法
                let promptText = `
                    ${systemContext}
                    ${styleDesc}
                    ${contentPrompt}
                    (Exclude: text, writing, words, letters, chinese characters, hanzi, kanji, signature, watermark, logo, typography, signboard, blackboard, book cover)
                `;

                // 壓縮 Prompt
                promptText = promptText.replace(/\s+/g, ' ').trim();

                // Imagen Payload: 回歸標準參數
                const payload = { 
                    instances: [{ prompt: promptText }], 
                    parameters: { sampleCount: 1 } 
                };

                try {
                    const response = await fetch(apiUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    if (!response.ok) throw new Error(`API request failed with status ${response.status}`);
                    const result = await response.json();
                    
                    // Imagen 回傳的是 predictions 陣列，圖片資料在 bytesBase64Encoded 中
                    const base64Data = result?.predictions?.[0]?.bytesBase64Encoded;
                    
                    if (base64Data) return `data:image/png;base64,${base64Data}`;
                    else throw new Error("Invalid response structure from image generation API.");
                } catch (error) { 
                    console.error(`Error generating image with AI (Level ${retryLevel}):`, error); 
                    return null; 
                }
            }
            
