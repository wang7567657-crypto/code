            async function saveHistoryToFirestore(historyData) {
                if (!db || !userId) return;
                // Don't save empty manual entries
                if (historyData.type === 'manual' && !historyData.content) return;

                try {
                    const historyCollection = collection(db, 'artifacts', appId, 'users', userId, 'history');
                    
                    // Check for duplicates
                    const q = query(historyCollection, orderBy("timestamp", "desc"), limit(1));
                    const querySnapshot = await getDocs(q);
                    if (!querySnapshot.empty) {
                        const lastEntry = querySnapshot.docs[0].data();
                        if (lastEntry.type === historyData.type) {
                            let isDuplicate = false;
                            if (historyData.type === 'manual') {
                                if (lastEntry.content === historyData.content) {
                                    isDuplicate = true;
                                }
                            } else if (historyData.type === 'textbook') {
                                // Using stringify for simple object comparison
                                if (JSON.stringify(lastEntry.content) === JSON.stringify(historyData.content)) {
                                     isDuplicate = true;
                                }
                            }
                            if (isDuplicate) {
                                console.log("History entry is the same as the last one. Skipping save.");
                                return;
                            }
                        }
                    }
                    
                    await addDoc(historyCollection, {
                        ...historyData,
                        timestamp: serverTimestamp()
                    });
                    console.log("History saved:", historyData);
                } catch (error) {
                    console.error("Error saving history:", error);
                }
            }
